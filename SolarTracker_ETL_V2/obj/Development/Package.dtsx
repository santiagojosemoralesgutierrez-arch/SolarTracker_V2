        <SQLTask:SqlTaskData
          SQLTask:Connection="{CB6E576A-60BF-4EEC-92F6-1403DAE27E72}"
          SQLTask:SqlStatementSource="-- A. Dim_Sistema&#xA;INSERT INTO Dim_Sistema (id_sistema, ubicacion)&#xA;SELECT DISTINCT id_sistema, ubicacion&#xA;FROM STAGING_Lecturas&#xA;WHERE id_sistema IS NOT NULL&#xA;  AND id_sistema NOT IN (SELECT id_sistema FROM Dim_Sistema);&#xA;&#xA;-- B. Dim_EstadoLuces&#xA;INSERT INTO Dim_EstadoLuces (descripcion_estado)&#xA;SELECT DISTINCT estado_luces&#xA;FROM STAGING_Lecturas&#xA;WHERE estado_luces IS NOT NULL&#xA;  AND estado_luces NOT IN (SELECT descripcion_estado FROM Dim_EstadoLuces);&#xA;&#xA;-- C. Dim_Tiempo&#xA;INSERT INTO Dim_Tiempo (marca_tiempo, Anio, Mes, Dia, Hora)&#xA;SELECT DISTINCT &#xA;    DATEADD(hour, DATEDIFF(hour, 0, marca_tiempo), 0),&#xA;    YEAR(marca_tiempo), MONTH(marca_tiempo), DAY(marca_tiempo), DATEPART(HOUR, marca_tiempo)&#xA;FROM STAGING_Lecturas S&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM Dim_Tiempo T &#xA;    WHERE T.Anio = YEAR(S.marca_tiempo) &#xA;      AND T.Mes = MONTH(S.marca_tiempo) &#xA;      AND T.Dia = DAY(S.marca_tiempo) &#xA;      AND T.Hora = DATEPART(HOUR, S.marca_tiempo)&#xA;);&#xA;&#xA;-- D. Dim_AnguloServo&#xA;INSERT INTO Dim_AnguloServo (valor_angulo)&#xA;SELECT DISTINCT angulo_servo&#xA;FROM STAGING_Lecturas&#xA;WHERE angulo_servo IS NOT NULL&#xA;  AND angulo_servo NOT IN (SELECT valor_angulo FROM Dim_AnguloServo);&#xA;&#xA;-- E. Dim_NivelPWM&#xA;INSERT INTO Dim_NivelPWM (nivel_pwm)&#xA;SELECT DISTINCT intensidad_pwm_luces&#xA;FROM STAGING_Lecturas&#xA;WHERE intensidad_pwm_luces IS NOT NULL&#xA;  AND intensidad_pwm_luces NOT IN (SELECT nivel_pwm FROM Dim_NivelPWM);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Poblar Fact_Rendimiento"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{82CCE8C6-B34A-4A8B-96F3-0E7A54E9EB03}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Poblar Fact_Rendimiento"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CB6E576A-60BF-4EEC-92F6-1403DAE27E72}"
          SQLTask:SqlStatementSource="INSERT INTO Fact_Rendimiento (&#xA;    id_sistema, id_tiempo, id_estado_luces, id_angulo, id_pwm, &#xA;    promedio_carga_bateria, max_voltaje_panel, promedio_diferencia_ldr&#xA;)&#xA;SELECT &#xA;    S.id_sistema,&#xA;    T.id_tiempo,&#xA;    E.id_estado_luces,&#xA;    A.id_angulo,&#xA;    P.id_pwm,&#xA;    AVG(L.porcentaje_carga_bateria) AS promedio_carga_bateria,&#xA;    MAX(L.voltaje_panel) AS max_voltaje_panel,&#xA;    AVG(L.ldr_izquierdo - L.ldr_derecho) AS promedio_diferencia_ldr&#xA;FROM STAGING_Lecturas L&#xA;JOIN Dim_Sistema S ON L.id_sistema = S.id_sistema&#xA;JOIN Dim_EstadoLuces E ON L.estado_luces = E.descripcion_estado&#xA;JOIN Dim_Tiempo T ON &#xA;    YEAR(L.marca_tiempo) = T.Anio AND &#xA;    MONTH(L.marca_tiempo) = T.Mes AND &#xA;    DAY(L.marca_tiempo) = T.Dia AND &#xA;    DATEPART(HOUR, L.marca_tiempo) = T.Hora&#xA;JOIN Dim_AnguloServo A ON L.angulo_servo = A.valor_angulo&#xA;JOIN Dim_NivelPWM P ON L.intensidad_pwm_luces = P.nivel_pwm&#xA;GROUP BY &#xA;    S.id_sistema,&#xA;    T.id_tiempo,&#xA;    E.id_estado_luces,&#xA;    A.id_angulo,&#xA;    P.id_pwm;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
