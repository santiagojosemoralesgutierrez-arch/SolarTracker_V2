    <DTS:Executable
      DTS:refId="Package\Población OLTP"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{CBC7A20E-ACEF-48E2-8627-7C8BC3C4F79F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Población OLTP"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CB6E576A-60BF-4EEC-92F6-1403DAE27E72}"
          SQLTask:SqlStatementSource="-- 1. Poblar Sistemas&#xA;INSERT INTO Sistemas (id_sistema, ubicacion)&#xA;SELECT DISTINCT id_sistema, ubicacion&#xA;FROM STAGING_Lecturas&#xA;WHERE id_sistema IS NOT NULL&#xA;  AND id_sistema NOT IN (SELECT id_sistema FROM Sistemas);&#xA;&#xA;-- 2. Poblar Lecturas&#xA;INSERT INTO Lecturas (id_lectura, id_sistema, marca_tiempo, ldr_izquierdo, ldr_derecho, Diferencia_LDR, angulo_servo, porcentaje_carga_bateria, voltaje_panel, estado_luces, intensidad_pwm_luces)&#xA;SELECT &#xA;    id_lectura, id_sistema, marca_tiempo, ldr_izquierdo, ldr_derecho, &#xA;    (ldr_izquierdo - ldr_derecho) AS Diferencia_LDR,&#xA;    angulo_servo, porcentaje_carga_bateria, voltaje_panel, estado_luces, intensidad_pwm_luces&#xA;FROM STAGING_Lecturas&#xA;WHERE id_lectura NOT IN (SELECT id_lectura FROM Lecturas);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
